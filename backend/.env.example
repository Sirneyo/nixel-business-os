# ── Nixel Business OS — Starter Edition ─────────────────────────────────────
# Copy this file to `.env` and fill in the values you need.
# Every external connection is optional: with no keys configured the app runs
# in Demo Mode using built-in simulated providers so you can explore safely.

# ── Core ────────────────────────────────────────────────────────────────────
# SQLite works out of the box. For production use PostgreSQL, e.g.
#   postgresql+psycopg://user:password@localhost:5432/nixel_starter
DATABASE_URL=sqlite:///./nixel_starter.db

# Public URL of the backend (used for tracking links and webhook examples).
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated origins allowed to call the API (your frontend URL).
CORS_ORIGINS=http://localhost:5173

# Force demo mode even when provider keys are present (true/false).
# Demo mode simulates search, verification, AI scoring and email sending.
DEMO_MODE=true

# ── Security ────────────────────────────────────────────────────────────────
# Shared secret required (as the X-API-Key header) by inbound lead webhooks.
# Generate one, e.g.:  python -c "import secrets; print(secrets.token_hex(24))"
INBOUND_WEBHOOK_KEY=

# ── AI provider (lead qualification & scoring) ──────────────────────────────
# Get a key at https://console.anthropic.com — leave blank to use the
# built-in heuristic scorer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Lead search provider ────────────────────────────────────────────────────
# Business discovery. Currently supported: google_places (or leave blank for
# the demo provider).
LEAD_SEARCH_PROVIDER=
GOOGLE_PLACES_API_KEY=

# ── Email verification ──────────────────────────────────────────────────────
# Built-in verification does syntax + DNS/MX checks and needs no key.
# Set to "demo" to simulate results instead of doing live DNS lookups.
EMAIL_VERIFY_MODE=builtin

# ── Email sending (SMTP — works with AWS SES, Postmark, Mailgun, etc.) ──────
# Leave blank to simulate sends. Use your own provider credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# ── Scheduler ───────────────────────────────────────────────────────────────
# Seconds between background engine ticks (campaign sends + automations).
SCHEDULER_INTERVAL_SECONDS=30
