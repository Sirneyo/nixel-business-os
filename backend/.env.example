# ── Nixel Business OS — Starter Edition ─────────────────────────────────────
# Copy this file to `.env` and fill in what you need.
#
# NOTE: provider credentials are normally entered inside the app at
# Settings → Connections — values saved there take precedence over this file.
# The variables below are a fallback, mainly useful for server deployments.

# ── Core ────────────────────────────────────────────────────────────────────
# SQLite works out of the box. For production use PostgreSQL, e.g.
#   postgresql+psycopg://user:password@localhost:5432/nixel_starter
DATABASE_URL=sqlite:///./nixel_starter.db

# Public URL of the backend (used for webhook examples and links).
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated origins allowed to call the API (your frontend URL).
# Any localhost port is always allowed for local development.
CORS_ORIGINS=http://localhost:5173

# ── Security ────────────────────────────────────────────────────────────────
# Shared secret required (as the X-API-Key header) by inbound lead webhooks.
# Generate one, e.g.:  python -c "import secrets; print(secrets.token_hex(24))"
INBOUND_WEBHOOK_KEY=

# ── AI lead scoring (optional — Settings → Connections preferred) ───────────
# Get a key at https://console.anthropic.com — leave blank to use the
# built-in rule-based scorer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Lead search (optional — Settings → Connections preferred) ───────────────
# Without a key, the built-in OpenStreetMap search is used (free, no signup).
GOOGLE_PLACES_API_KEY=

# ── Email sending (optional — Settings → Connections preferred) ─────────────
# Works with any SMTP provider: AWS SES, Postmark, Mailgun, SendGrid, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# ── Scheduler ───────────────────────────────────────────────────────────────
# Seconds between background ticks (campaign sends + automations).
SCHEDULER_INTERVAL_SECONDS=30
